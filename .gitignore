.venv/
__pycache__/
*.pyc
simulation/out/
MUJOCO_LOG.TXT
.venv-autobio/
MJDATA.TXT
MJMODEL.TXT

# Detector weights, datasets and outputs written by the computer-vision scripts
/third_party/
results/
data/
# training runs: keep only the scripts, never weights, logs or plots
**/runs/**
!**/runs/**/
!**/runs/**/*.py
# Weights live in computer-vision/weights/ and never in git. The contents are
# ignored rather than the folder, because git does not descend into an ignored
# directory and the README would go with it.
**/weights/*
!**/weights/README.md
*.pt
*.torchscript
*.onnx
*.mp4
*.log
mobileclip*.ts
