.venv/
__pycache__/
*.pyc
simulation/out/
MUJOCO_LOG.TXT
.venv-autobio/
.venv-act/
MJDATA.TXT
MJMODEL.TXT
# Seeded worktop patterns: patterns/*.json is the definition and is committed;
# the room and scene XML a seed expands into are rebuilt on demand with
# scripts/generate_minihannover_open.py --pattern <name>.
simulation/assets/minihannover_open/lab_room_[ps]*.xml
simulation/models/minihannover_open_scene_[ps]*.xml
# Only the ten catalogue patterns are committed; s<seed>.json is a scratch build.
simulation/assets/minihannover_open/patterns/s*.json

# Detector weights, datasets and outputs written by the computer-vision scripts
/third_party/
results/
data/
# training runs: keep only the scripts, never weights, logs or plots
**/runs/**
!**/runs/**/
!**/runs/**/*.py
# Weights live in computer-vision/weights/ and never in git. The contents are
# ignored rather than the folder, because git does not descend into an ignored
# directory and the README would go with it.
**/weights/*
!**/weights/README.md
*.pt
*.torchscript
*.onnx
*.mp4
!view/frontend/public/renders/rail_global.mp4
!view/frontend/public/renders/rail_robot.mp4
!simulation/media/initial_scan_realtime.mp4
*.log
mobileclip*.ts

# Scene renders written by harness/vision.py. Regenerable from the scenes, and
# 15 MB of PNG is not worth carrying in history; the scripts and the catalogue
# beside them are tracked.
harness/frames/

# Menagerie models, fetched by simulation/scripts/fetch_menagerie.sh. No
# trailing slash: the sparse clone carries its own .git, so `git add` turns the
# directory into a gitlink with no .gitmodules entry behind it, and everyone
# who clones gets an empty directory git then reports as modified for ever.
simulation/third_party/mujoco_menagerie

# The gripper variant of the rail scene, built on demand by scripts/vision_pick.py
simulation/models/minihannover_rail_gripper_scene.xml
simulation/assets/ur10e_2f85_gripper/
