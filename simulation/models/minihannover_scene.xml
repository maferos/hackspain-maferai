<?xml version="1.0" encoding="utf-8"?>
<!-- Demo scene: a perfumery / formulation lab built around the minihannover bench.
     The room (14 x 5 x 3 m, generated by scripts/generate_lab_room.py) is a long white
     cleanroom-style space: the bench carries a shelving gantry stocked with the sample
     library (187 barcoded bottles, powders in white HDPE and liquids in amber glass,
     scattered in no order),
     a wall bench with equipment runs along the right (-y) wall, a glass partition
     closes the far (+x) end, and the entrance storage corner is at -x. This file only
     composes the assets: bench, room, sink, balances, instruments and the loose
     sample bottles, which are the only movable bodies.

     The viewer opens at the entrance, looking down the room. Press "2" to hide the
     ceiling and look in from above. Named cameras follow the lab walkthrough:
     entrance, aisle, library, wash, drying_rack, far_end, overview.

     python scripts/view_model.py models/minihannover_scene.xml -->
<mujoco model="minihannover_scene">
  <statistic center="-4.6 -1.0 1.35" extent="2.4"/>

  <visual>
    <headlight diffuse="0.26 0.26 0.27" ambient="0.36 0.36 0.38" specular="0.05 0.05 0.05"/>
    <global azimuth="8" elevation="-10" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <material name="floor" rgba="0.80 0.81 0.81 1" specular="0.3" shininess="0.6" reflectance="0.12"/>
    <model name="lab_room" file="../assets/lab_room/lab_room.xml"/>
    <model name="sink" file="../assets/sink/sink.xml"/>
    <model name="balance" file="../assets/balance/balance.xml"/>
    <model name="gc_ms" file="../assets/gc_ms/gc_ms.xml"/>
    <model name="uv_vis_nir" file="../assets/uv_vis_nir/uv_vis_nir.xml"/>
    <!-- Sample containers: every one is a catalogued sample carrying its own EAN-13
         label (assets/labelled_bottles, from tools/build_labelled_bottles.py). Powders
         are in white HDPE bottles, liquids in amber glass; the barcode resolves to the
         sample through computer-vision/barcodes/lookup_table.json. The rest of the
         catalogue stands on the gantry, put there by scripts/generate_lab_room.py, which
         lists these thirteen as PLACED_BY_SCENE so that no sample is in the room twice. -->
    <model name="pwd_0004" file="../assets/labelled_bottles/PWD-0004.xml"/>  <!-- Vanillin, 1 L -->
    <model name="pwd_0008" file="../assets/labelled_bottles/PWD-0008.xml"/>  <!-- Ethylvanillin, 500 ml -->
    <model name="pwd_0012" file="../assets/labelled_bottles/PWD-0012.xml"/>  <!-- Coumarin, 250 ml -->
    <model name="pwd_0020" file="../assets/labelled_bottles/PWD-0020.xml"/>  <!-- Maltol, 2 L -->
    <model name="pwd_0024" file="../assets/labelled_bottles/PWD-0024.xml"/>  <!-- Ethyl maltol, 1 L -->
    <model name="pwd_0026" file="../assets/labelled_bottles/PWD-0026.xml"/>  <!-- Menthol, 100 ml -->
    <model name="smp_0005" file="../assets/labelled_bottles/SMP-0005.xml"/>  <!-- Limonene, 100 ml -->
    <model name="smp_0009" file="../assets/labelled_bottles/SMP-0009.xml"/>  <!-- Linalool, 50 ml -->
    <model name="smp_0013" file="../assets/labelled_bottles/SMP-0013.xml"/>  <!-- Geraniol, 30 ml -->
    <model name="smp_0017" file="../assets/labelled_bottles/SMP-0017.xml"/>  <!-- Citral, 20 ml -->
    <model name="smp_0021" file="../assets/labelled_bottles/SMP-0021.xml"/>  <!-- Eugenol, 10 ml -->
    <model name="smp_0030" file="../assets/labelled_bottles/SMP-0030.xml"/>  <!-- Benzaldehyde, 100 ml -->
    <model name="smp_0034" file="../assets/labelled_bottles/SMP-0034.xml"/>  <!-- Citronellol, 50 ml -->
  </asset>

  <include file="../assets/minihannover/minihannover.xml"/>

  <worldbody>
    <!-- Continuous light-grey resin floor, slight gloss. -->
    <geom name="floor" type="plane" size="12 12 0.05" material="floor"/>

    <!-- Room shell, furniture, shelving + amber library, lights and cameras. -->
    <attach model="lab_room" body="lab_room" prefix="room_"/>

    <!-- Wash zone: one sink at the head of the bench, next to the glass partition. It is
         turned 90 degrees so its 1.50 m length spans the bench width, tap edge (+y of
         the sink) against the bench. Sink depth is 0.754 m: centre at x = 3.0 + 0.377. -->
    <frame pos="3.377 0 0" quat="0.70710678 0 0 0.70710678">
      <attach model="sink" body="sink" prefix="sink_"/>
    </frame>

    <!-- Angles in this file are RADIANS: the bench include (minihannover.xml) sets
         <compiler angle="radian"/>, and an include's compiler applies to the file that
         includes it. (Attached models such as lab_room.xml compile on their own, in
         degrees.) euler="0 0 180" here is 180 rad, which lands at -127 degrees. -->

    <!-- Five analytical balances along the bench, on the worktop (z = 0.90) in front of
         the gantry. Keypads face the aisle: -y side as converted, +y side turned half a
         turn. Two stand on the framed mats the room generator draws (4 mm). -->
    <frame pos="-1.85 -0.51 0.904"><attach model="balance" body="balance" prefix="balance_1_"/></frame>
    <frame pos="-0.2 -0.51 0.9"><attach model="balance" body="balance" prefix="balance_2_"/></frame>
    <frame pos="1.3 -0.51 0.9"><attach model="balance" body="balance" prefix="balance_3_"/></frame>
    <frame pos="-1.0 0.51 0.9" euler="0 0 3.1416"><attach model="balance" body="balance" prefix="balance_4_"/></frame>
    <frame pos="0.75 0.51 0.904" euler="0 0 3.1416"><attach model="balance" body="balance" prefix="balance_5_"/></frame>

    <!-- Instruments on the left-wall instrument bench (top at z = 0.90), fronts facing
         the room (-y). Not in the reference video; added on request. The GC-MS size
         is an assumed scale (see assets/gc_ms/README.md). -->
    <frame pos="-5.85 1.78 0.9"><attach model="gc_ms" body="gc_ms" prefix="gc_ms_"/></frame>
    <frame pos="-4.5 1.75 0.9"><attach model="uv_vis_nir" body="uv_vis_nir" prefix="uv_vis_nir_"/></frame>

    <!-- The thirteen hand-placed samples are mixed on purpose, like the gantry: powder
         bottles and liquid flasks share the corner counter and the worktop, so where a
         bottle stands says nothing about what is in it. A bottle's label faces its own
         -y; each is turned so the label looks into the room or at the nearer aisle, give
         or take, as bottles put down by hand do. -->

    <!-- Entrance corner counter (top at z = 0.90). Welded, like the rest of the corner. -->
    <frame pos="-7.82 -2.36 0.9" euler="0 0 3.0020"><attach model="pwd_0004" body="PWD-0004" prefix="corner_1_"/></frame>
    <frame pos="-7.68 -2.3 0.9" euler="0 0 3.5430"><attach model="smp_0005" body="SMP-0005" prefix="corner_2_"/></frame>
    <frame pos="-7.55 -2.38 0.9" euler="0 0 2.7053"><attach model="smp_0030" body="SMP-0030" prefix="corner_3_"/></frame>
    <frame pos="-8.3 -1.95 0.9" euler="0 0 1.7104"><attach model="pwd_0020" body="PWD-0020" prefix="corner_4_"/></frame>
    <frame pos="-8.3 -1.75 0.9" euler="0 0 1.2217"><attach model="pwd_0024" body="PWD-0024" prefix="corner_5_"/></frame>
    <frame pos="-8.05 -1.45 0.9" euler="0 0 2.0944"><attach model="smp_0034" body="SMP-0034" prefix="corner_6_"/></frame>

    <!-- Loose bottles on the worktop: the movable objects. Each is a free body wrapping
         a labelled bottle; inertia="exact", so an empty 100 ml amber flask weighs 91 g. -->
    <body name="loose_1" pos="-2.25 -0.6 0.9" euler="0 0 0.2094"><freejoint/><attach model="smp_0009" body="SMP-0009" prefix="loose_1_"/></body>
    <body name="loose_2" pos="-2.33 -0.46 0.9" euler="0 0 -0.4014"><freejoint/><attach model="pwd_0012" body="PWD-0012" prefix="loose_2_"/></body>
    <body name="loose_3" pos="0.72 -0.62 0.9" euler="0 0 -0.1396"><freejoint/><attach model="smp_0021" body="SMP-0021" prefix="loose_3_"/></body>
    <body name="loose_4" pos="0.82 -0.5 0.9" euler="0 0 0.4363"><freejoint/><attach model="pwd_0026" body="PWD-0026" prefix="loose_4_"/></body>
    <body name="loose_5" pos="0.1 0.58 0.9" euler="0 0 2.9671"><freejoint/><attach model="smp_0013" body="SMP-0013" prefix="loose_5_"/></body>
    <body name="loose_6" pos="0.2 0.45 0.9" euler="0 0 3.4907"><freejoint/><attach model="pwd_0008" body="PWD-0008" prefix="loose_6_"/></body>
    <body name="loose_7" pos="1.95 0.62 0.9" euler="0 0 3.2289"><freejoint/><attach model="smp_0017" body="SMP-0017" prefix="loose_7_"/></body>
  </worldbody>
</mujoco>
