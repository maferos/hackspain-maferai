<?xml version="1.0" encoding="utf-8"?>
<!-- Demo scene: the minihannover bench on a floor. Open it with
     python scripts/view_model.py models/minihannover_scene.xml -->
<mujoco model="minihannover_scene">
  <statistic center="0 0 0.6" extent="7"/>

  <visual>
    <headlight diffuse="0.5 0.5 0.5" ambient="0.3 0.3 0.3"/>
    <global azimuth="130" elevation="-20"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.24 0.26 0.28"
             rgb2="0.30 0.32 0.34" width="300" height="300"/>
    <material name="grid" texture="grid" texrepeat="12 12" reflectance="0.1"/>
  </asset>

  <include file="../assets/minihannover/minihannover.xml"/>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="12 12 0.05" material="grid"/>
  </worldbody>
</mujoco>
