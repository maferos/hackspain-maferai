<?xml version="1.0" encoding="utf-8"?>
<!-- Demo scene: a perfumery / formulation lab built around the minihannover bench.
     The room (14 x 5 x 3 m, generated by scripts/generate_lab_room.py) is a long white
     cleanroom-style space: the bench carries a shelving gantry full of amber bottles,
     a wall bench with equipment runs along the right (-y) wall, a glass partition
     closes the far (+x) end, and the entrance storage corner is at -x. This file only
     composes the assets: bench, room, sink, balances, instruments and the loose
     bottles, which are the only movable bodies.

     The viewer opens at the entrance, looking down the room. Press "2" to hide the
     ceiling and look in from above. Named cameras follow the lab walkthrough:
     entrance, aisle, library, wash, drying_rack, far_end, overview.

     python scripts/view_model.py models/minihannover_scene.xml -->
<mujoco model="minihannover_scene">
  <statistic center="-4.6 -1.0 1.35" extent="2.4"/>

  <visual>
    <headlight diffuse="0.26 0.26 0.27" ambient="0.36 0.36 0.38" specular="0.05 0.05 0.05"/>
    <global azimuth="8" elevation="-10" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <material name="floor" rgba="0.80 0.81 0.81 1" specular="0.3" shininess="0.6" reflectance="0.12"/>
    <model name="lab_room" file="../assets/lab_room/lab_room.xml"/>
    <model name="sink" file="../assets/sink/sink.xml"/>
    <model name="balance" file="../assets/balance/balance.xml"/>
    <model name="gc_ms" file="../assets/gc_ms/gc_ms.xml"/>
    <model name="uv_vis_nir" file="../assets/uv_vis_nir/uv_vis_nir.xml"/>
    <model name="amber_060ml" file="../assets/amber_bottles/amber_060ml.xml"/>
    <model name="amber_100ml" file="../assets/amber_bottles/amber_100ml.xml"/>
    <model name="jar_250ml" file="../assets/reagent_jars/jar_250ml.xml"/>
    <model name="jar_500ml" file="../assets/reagent_jars/jar_500ml.xml"/>
    <model name="jar_1000ml" file="../assets/reagent_jars/jar_1000ml.xml"/>
    <model name="bottle_500ml" file="../assets/agro_bottles/bottle_500ml.xml"/>
    <model name="bottle_1l" file="../assets/agro_bottles/bottle_1l.xml"/>
    <model name="bottle_2l" file="../assets/agro_bottles/bottle_2l.xml"/>
    <model name="cap_500ml" file="../assets/agro_bottles/cap_500ml.xml"/>
    <model name="cap_1l" file="../assets/agro_bottles/cap_1l.xml"/>
    <model name="cap_2l" file="../assets/agro_bottles/cap_2l.xml"/>
  </asset>

  <include file="../assets/minihannover/minihannover.xml"/>

  <worldbody>
    <!-- Continuous light-grey resin floor, slight gloss. -->
    <geom name="floor" type="plane" size="12 12 0.05" material="floor"/>

    <!-- Room shell, furniture, shelving + amber library, lights and cameras. -->
    <attach model="lab_room" body="lab_room" prefix="room_"/>

    <!-- Wash zone: one sink at the head of the bench, next to the glass partition. It is
         turned 90 degrees so its 1.50 m length spans the bench width, tap edge (+y of
         the sink) against the bench. Sink depth is 0.754 m: centre at x = 3.0 + 0.377. -->
    <frame pos="3.377 0 0" quat="0.70710678 0 0 0.70710678">
      <attach model="sink" body="sink" prefix="sink_"/>
    </frame>

    <!-- Five analytical balances along the bench, on the worktop (z = 0.90) in front of
         the gantry. Keypads face the aisle: -y side as converted, +y side turned 180
         degrees. Two stand on the framed mats the room generator draws (4 mm). -->
    <frame pos="-1.85 -0.51 0.904"><attach model="balance" body="balance" prefix="balance_1_"/></frame>
    <frame pos="-0.2 -0.51 0.9"><attach model="balance" body="balance" prefix="balance_2_"/></frame>
    <frame pos="1.3 -0.51 0.9"><attach model="balance" body="balance" prefix="balance_3_"/></frame>
    <frame pos="-1.0 0.51 0.9" euler="0 0 180"><attach model="balance" body="balance" prefix="balance_4_"/></frame>
    <frame pos="0.75 0.51 0.904" euler="0 0 180"><attach model="balance" body="balance" prefix="balance_5_"/></frame>

    <!-- Instruments on the left-wall instrument bench (top at z = 0.90), fronts facing
         the room (-y). Not in the reference video; added on request. The GC-MS size
         is an assumed scale (see assets/gc_ms/README.md). -->
    <frame pos="-5.85 1.78 0.9"><attach model="gc_ms" body="gc_ms" prefix="gc_ms_"/></frame>
    <frame pos="-4.5 1.75 0.9"><attach model="uv_vis_nir" body="uv_vis_nir" prefix="uv_vis_nir_"/></frame>

    <!-- Entrance corner counter (top at z = 0.90): HDPE powder jars and white bottles. -->
    <frame pos="-7.82 -2.36 0.9"><attach model="jar_1000ml" body="jar_1000ml" prefix="corner_jar_1_"/></frame>
    <frame pos="-7.68 -2.3 0.9"><attach model="jar_500ml" body="jar_500ml" prefix="corner_jar_2_"/></frame>
    <frame pos="-7.55 -2.38 0.9"><attach model="jar_250ml" body="jar_250ml" prefix="corner_jar_3_"/></frame>
    <frame pos="-8.3 -1.95 0.9"><attach model="bottle_2l" body="bottle_2l" prefix="corner_bottle_1_"/></frame>
    <frame pos="-8.3 -1.95 1.114"><attach model="cap_2l" body="cap_2l" prefix="corner_cap_1_"/></frame>
    <frame pos="-8.3 -1.75 0.9"><attach model="bottle_1l" body="bottle_1l" prefix="corner_bottle_2_"/></frame>
    <frame pos="-8.3 -1.75 1.091"><attach model="cap_1l" body="cap_1l" prefix="corner_cap_2_"/></frame>
    <frame pos="-8.05 -1.45 0.9"><attach model="bottle_500ml" body="bottle_500ml" prefix="corner_bottle_3_"/></frame>
    <frame pos="-8.05 -1.45 1.04"><attach model="cap_500ml" body="cap_500ml" prefix="corner_cap_3_"/></frame>

    <!-- Loose amber bottles on the worktop: the movable objects. Each is a free body
         wrapping the converted kit bottle (inertia="exact", 65 g / 96 g). -->
    <body name="amber_loose_1" pos="-2.25 -0.6 0.9"><freejoint/><attach model="amber_060ml" body="amber_060ml" prefix="amber_loose_1_"/></body>
    <body name="amber_loose_2" pos="-2.33 -0.46 0.9"><freejoint/><attach model="amber_100ml" body="amber_100ml" prefix="amber_loose_2_"/></body>
    <body name="amber_loose_3" pos="0.72 -0.62 0.9"><freejoint/><attach model="amber_060ml" body="amber_060ml" prefix="amber_loose_3_"/></body>
    <body name="amber_loose_4" pos="0.82 -0.5 0.9"><freejoint/><attach model="amber_100ml" body="amber_100ml" prefix="amber_loose_4_"/></body>
    <body name="amber_loose_5" pos="0.1 0.58 0.9"><freejoint/><attach model="amber_060ml" body="amber_060ml" prefix="amber_loose_5_"/></body>
    <body name="amber_loose_6" pos="0.2 0.45 0.9"><freejoint/><attach model="amber_100ml" body="amber_100ml" prefix="amber_loose_6_"/></body>
    <body name="amber_loose_7" pos="1.95 0.62 0.9"><freejoint/><attach model="amber_060ml" body="amber_060ml" prefix="amber_loose_7_"/></body>
  </worldbody>
</mujoco>
