<!-- Minimal MJCF scene: a floor, a light, and a few falling bodies. -->
<mujoco model="hello">
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <visual>
    <headlight ambient="0.3 0.3 0.3"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1=".2 .3 .4" rgb2=".1 .15 .2"
             width="512" height="512"/>
    <material name="grid" texture="grid" texrepeat="4 4" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid"/>

    <body name="box" pos="0 0 1" euler="20 30 0">
      <freejoint/>
      <geom type="box" size="0.1 0.1 0.1" rgba="0.9 0.3 0.3 1"/>
    </body>

    <body name="sphere" pos="0.25 0.1 1.5">
      <freejoint/>
      <geom type="sphere" size="0.1" rgba="0.3 0.9 0.3 1"/>
    </body>

    <body name="capsule" pos="-0.2 -0.1 2" euler="0 60 0">
      <freejoint/>
      <geom type="capsule" size="0.05 0.15" rgba="0.3 0.3 0.9 1"/>
    </body>
  </worldbody>
</mujoco>
